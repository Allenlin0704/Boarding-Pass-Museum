<Application
    x:Class="BoardingPassMuseum.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <controls:XamlControlsResources />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FA" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#14253D" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#60728A" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#1767B1" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101820" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#192632" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#F3F7FB" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#A6B6C6" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#66B6FF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
