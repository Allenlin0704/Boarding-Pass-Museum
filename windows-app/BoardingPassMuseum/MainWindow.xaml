<Window
    x:Class="BoardingPassMuseum.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="BoardingPassMuseum">
  <Grid Background="{ThemeResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{ThemeResource AppSurfaceBrush}" Padding="18,12">
      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="Assets/brand-mark.png" Width="36" Height="36" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="BoardingPassMuseum" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
          <TextBlock Text="收藏每一次起飞，保存每一段旅程" FontSize="12" Foreground="{ThemeResource AppMutedBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="BackButton" Content="返回" Click="BackButton_Click" IsEnabled="False" />
          <Button Content="刷新" Click="RefreshButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnSpacing="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{ThemeResource AppSurfaceBrush}" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="工作区" Margin="8,12,0,8" FontSize="12" Foreground="{ThemeResource AppMutedBrush}" />
          <Button x:Name="GalleryButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="GalleryButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="✈"/><TextBlock Text="线上展厅"/></StackPanel>
          </Button>
          <Button x:Name="AdminButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="AdminButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="▤"/><TextBlock Text="管理入口"/></StackPanel>
          </Button>
          <Border Margin="8,18,8,0" Padding="10" CornerRadius="8" Background="{ThemeResource AppBackgroundBrush}">
            <TextBlock Text="管理端会通过 BoardingPassMuseum 官方管理域名登录。管理员和站长权限仍由服务器验证。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource AppMutedBrush}" />
          </Border>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="12">
        <controls:WebView2 x:Name="SiteView" />
        <Border x:Name="FailurePanel" Visibility="Collapsed" Background="{ThemeResource AppSurfaceBrush}" CornerRadius="14" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
          <StackPanel Spacing="12">
            <TextBlock Text="暂时无法连接 BoardingPassMuseum" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
            <TextBlock Text="请检查网络连接后重试。你的账户和投稿数据仍保存在网站服务端。" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedBrush}" />
            <Button Content="重新连接" HorizontalAlignment="Left" Click="RefreshButton_Click" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{ThemeResource AppSurfaceBrush}" Padding="16,8">
      <TextBlock x:Name="StatusText" Text="安全连接到 bpmuseum.org.cn" FontSize="12" Foreground="{ThemeResource AppMutedBrush}" />
    </Border>
  </Grid>
</Window>
